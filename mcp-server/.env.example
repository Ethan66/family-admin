# 服务器上建议使用仅内网可达的后端地址，必须以 /api 结尾。
FAMILY_API_URL=http://127.0.0.1:8080/api
# 普通成员可不填 FAMILY_ID；超级管理员必须固定家庭。
FAMILY_USERNAME=
FAMILY_PASSWORD=
FAMILY_ID=
# 默认记账/任务成员，必须是上述家庭成员；admin 必须配置或在调用时明确选择成员。
FAMILY_DEFAULT_MEMBER_ID=
# 课程专用默认成员；未配置时才回退到通用默认成员。
FAMILY_COURSE_DEFAULT_MEMBER_ID=
FAMILY_STATE_PATH=/opt/family-admin-mcp/state/requests.sqlite3
FAMILY_TIMEOUT_SECONDS=15
