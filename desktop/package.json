{
  "name": "family-admin-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "vue-tsc -b --pretty false",
    "tauri": "tauri",
    "tauri:dev:local": "tauri dev --config src-tauri/tauri.local.conf.json",
    "tauri:dev:server": "tauri dev --config src-tauri/tauri.server.conf.json",
    "tauri:build:local": "tauri build --config src-tauri/tauri.local.conf.json",
    "tauri:build:server": "tauri build --config src-tauri/tauri.server.conf.json"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "axios": "^1.12.2",
    "dompurify": "^3.2.7",
    "element-plus": "^2.14.6",
    "marked": "^16.3.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.43",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.5.2",
    "@unocss/preset-uno": "^66.10.5",
    "@unocss/reset": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.2",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
